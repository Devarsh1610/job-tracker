<h1 class="mb-4">Public Applications List</h1>
<p class="text-muted">This is a read-only view of all applications logged in JobTrackr. Log in to add or manage your own.</p>

<div class="table-responsive">
  <table class="table table-hover bg-white">
    <thead>
      <tr>
        <th>Company</th>
        <th>Job Title</th>
        <th>Date Applied</th>
        <th>Status</th>
        <th>Submitted By</th>
      </tr>
    </thead>
    <tbody>
      {{#each applications}}
      <tr>
        <td>{{this.company}}</td>
        <td>{{this.jobTitle}}</td>
        <td>{{formatDate this.applicationDate}}</td>
        <td><span class="badge badge-status-{{this.status}}">{{this.status}}</span></td>
        <td>{{this.owner.username}}</td>
      </tr>
      {{else}}
      <tr><td colspan="5" class="text-center text-muted">No applications yet.</td></tr>
      {{/each}}
    </tbody>
  </table>
</div>
